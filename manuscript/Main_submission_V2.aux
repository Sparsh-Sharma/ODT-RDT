\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Component energy fractions $\overline  {u_i^2}/2k_t$ against total strain $e=St$ for initially isotropic turbulence under (\textit  {a}) plane strain $\mathsf  {A}=\mathrm  {diag}(a,-a,0)$ and (\textit  {b}) axisymmetric strain $\mathsf  {A}=\mathrm  {diag}(-\tfrac  {\gamma }{2},-\tfrac  {\gamma }{2},\gamma )$, normalised to $S=1$. Solid: exact rapid-distortion theory (wavevector-ensemble integration of \eqref  {eq:rdt}); dashed: present model with the LRR closure~\eqref  {eq:lrr}; dotted: present model with the IP closure~\eqref  {eq:iso-closure}. Colour denotes the velocity component. For axisymmetric strain the two lateral components coincide, $\overline  {u_1^2}=\overline  {u_2^2}$. All closures share the exact onset slope; the LRR closure tracks the exact solution more closely at finite strain.}}{16}{figure.caption.2}\protected@file@percent }
\newlabel{fig:rdt-components}{{1}{16}{Component energy fractions $\overline {u_i^2}/2k_t$ against total strain $e=St$ for initially isotropic turbulence under (\textit {a}) plane strain $\mathsf {A}=\mathrm {diag}(a,-a,0)$ and (\textit {b}) axisymmetric strain $\mathsf {A}=\mathrm {diag}(-\tfrac {\gamma }{2},-\tfrac {\gamma }{2},\gamma )$, normalised to $S=1$. Solid: exact rapid-distortion theory (wavevector-ensemble integration of \eqref {eq:rdt}); dashed: present model with the LRR closure~\eqref {eq:lrr}; dotted: present model with the IP closure~\eqref {eq:iso-closure}. Colour denotes the velocity component. For axisymmetric strain the two lateral components coincide, $\overline {u_1^2}=\overline {u_2^2}$. All closures share the exact onset slope; the LRR closure tracks the exact solution more closely at finite strain}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.1.4.}Upwash amplification and the necessity of the rapid pressure--strain}{16}{subsubsection.4.1.4}\protected@file@percent }
\newlabel{sec:upwash-verif}{{4.1.4}{16}{}{subsubsection.4.1.4}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Upwash energy fraction $\overline  {u_2^2}/2k_t$ against total strain under plane strain, for initially isotropic turbulence. Black: exact rapid-distortion theory; blue dashed: present model with the LRR closure; red dash-dotted: present model with the IP closure; grey dotted: production alone ($B_{ij}=0$). Production without the rapid pressure--strain overstates the onset amplification rate by $\tfrac  52$ and forces almost all the energy into the upwash component; the rapid term restores the physical, bounded amplification.}}{17}{figure.caption.3}\protected@file@percent }
\newlabel{fig:rdt-upwash}{{2}{17}{Upwash energy fraction $\overline {u_2^2}/2k_t$ against total strain under plane strain, for initially isotropic turbulence. Black: exact rapid-distortion theory; blue dashed: present model with the LRR closure; red dash-dotted: present model with the IP closure; grey dotted: production alone ($B_{ij}=0$). Production without the rapid pressure--strain overstates the onset amplification rate by $\tfrac 52$ and forces almost all the energy into the upwash component; the rapid term restores the physical, bounded amplification}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.1.5.}Verification of the strain-coupled ODT implementation}{17}{subsubsection.4.1.5}\protected@file@percent }
\newlabel{sec:level1a}{{4.1.5}{17}{}{subsubsection.4.1.5}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Verification of the strain-coupled ODT implementation under plane strain, with eddy events suppressed and zero molecular diffusion. (\textit  {a}) Component energy fractions $\overline  {u_i^2}/2k_t$ (colour denotes the component); (\textit  {b}) turbulent kinetic energy amplification $k_t(e)/k_t(0)$. Symbols: ODT solver, length-weighted line averages at the output times. Dashed: the LRR closure~\eqref  {eq:lrr} integrated as a moment equation. Solid: exact rapid-distortion theory. The solver reproduces the LRR closure in the fractions (to $5\times 10^{-4}$) and in the energy amplification (to within $3\%$); the residual energy deficit at large strain is interpolation loss from the adaptive mesh under-resolving the strained fine scales, and is addressed in \S  \,\ref {sec:val-spectrum}.}}{18}{figure.caption.4}\protected@file@percent }
\newlabel{fig:level1a}{{3}{18}{Verification of the strain-coupled ODT implementation under plane strain, with eddy events suppressed and zero molecular diffusion. (\textit {a}) Component energy fractions $\overline {u_i^2}/2k_t$ (colour denotes the component); (\textit {b}) turbulent kinetic energy amplification $k_t(e)/k_t(0)$. Symbols: ODT solver, length-weighted line averages at the output times. Dashed: the LRR closure~\eqref {eq:lrr} integrated as a moment equation. Solid: exact rapid-distortion theory. The solver reproduces the LRR closure in the fractions (to $5\times 10^{-4}$) and in the energy amplification (to within $3\%$); the residual energy deficit at large strain is interpolation loss from the adaptive mesh under-resolving the strained fine scales, and is addressed in \S \,\ref {sec:val-spectrum}}{figure.caption.4}{}}
\newlabel{eq:dlnkt}{{4.6}{18}{}{equation.4.6}{}}
