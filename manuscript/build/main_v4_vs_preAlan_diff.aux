\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Computed against prescribed inflow at application strains, judged by the linear reference: absolute SPL at the reference configuration for the rapid family ($Sk_t/\varepsilon \approx 8$) at (\textit  {a}) $e=1$ and (\textit  {b}) $e=2$. Solid black: exact (inviscid) RDT of the model's relaxed initial state---the reference the strained-box DNS of \S  \,\ref {sec:box-dns} validates at rapid rates---with level set by the kernel's exact upwash amplification (reproducing the moment-level value to $0.7\%$). Black dashed: the frozen von K\'arm\'an inflow of standard practice. {\color {red}\sout {Grey }}{\color {blue}\uwave {Black with markers }}(circles: SC-ODT; triangles: clock-relaxed ODT): the two computed inflows (fitted representations, measured ensemble levels), each with a {\color {blue}\uwave {grey }}band giving its measured spectral rms distance from the RDT family mapped to decibels; the {\color {red}\sout {two share }}{\color {blue}\uwave {bands overlap sufficiently that }}the {\color {red}\sout {band and }}{\color {blue}\uwave {two inflows }}are indistinguishable at this level.}}{42}{figure.caption.24}\protected@file@percent }
\newlabel{fig:amiet-rapid}{{21}{42}{Computed against prescribed inflow at application strains, judged by the linear reference: absolute SPL at the reference configuration for the rapid family ($Sk_t/\varepsilon \approx 8$) at (\textit {a}) $e=1$ and (\textit {b}) $e=2$. Solid black: exact (inviscid) RDT of the model's relaxed initial state---the reference the strained-box DNS of \S \,\ref {sec:box-dns} validates at rapid rates---with level set by the kernel's exact upwash amplification (reproducing the moment-level value to $0.7\%$). Black dashed: the frozen von K\'arm\'an inflow of standard practice. \DIFdelbeginFL \DIFdelFL {Grey }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {Black with markers }\DIFaddendFL (circles: SC-ODT; triangles: clock-relaxed ODT): the two computed inflows (fitted representations, measured ensemble levels), each with a \DIFaddbeginFL \DIFaddFL {grey }\DIFaddendFL band giving its measured spectral rms distance from the RDT family mapped to decibels; the \DIFdelbeginFL \DIFdelFL {two share }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {bands overlap sufficiently that }\DIFaddendFL the \DIFdelbeginFL \DIFdelFL {band and }\DIFdelendFL \DIFaddbeginFL \DIFaddFL {two inflows }\DIFaddendFL are indistinguishable at this level}{figure.caption.24}{}}
