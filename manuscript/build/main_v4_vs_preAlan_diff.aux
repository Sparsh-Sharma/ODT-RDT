\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces {\color {blue}\uwave {The cost of the frozen-inflow assumption against accumulated distortion: signed far-field prediction error, judged by the best available reference at each strain. Laboratory window (shaded): the eight measured cases of figure~\ref {fig:expval}, bias over each case's comparison band---flat plates filled, NACA0012 open (its common overprediction is the finite-thickness effect); horizontal bars span the effective-strain truncation range, and the three inflow chains are offset slightly in $e$ for legibility. Beyond the window: band-mean error over $100$--$1000$\,Hz against the exact-RDT reference of figure~\ref {fig:amiet-rapid} at $e=0.5$, $1$ and $2$; shaded bands give the $\pm 10\log _{10}(1+\mathrm  {rms})$ spectral-distance uncertainty where measured ($e=1$, $2$).}}}}{43}{figure.caption.25}\protected@file@percent }
\newlabel{fig:frozen-cost}{{22}{43}{\DIFaddFL {The cost of the frozen-inflow assumption against accumulated distortion: signed far-field prediction error, judged by the best available reference at each strain. Laboratory window (shaded): the eight measured cases of figure~\ref {fig:expval}, bias over each case's comparison band---flat plates filled, NACA0012 open (its common overprediction is the finite-thickness effect); horizontal bars span the effective-strain truncation range, and the three inflow chains are offset slightly in $e$ for legibility. Beyond the window: band-mean error over $100$--$1000$\,Hz against the exact-RDT reference of figure~\ref {fig:amiet-rapid} at $e=0.5$, $1$ and $2$; shaded bands give the $\pm 10\log _{10}(1+\mathrm {rms})$ spectral-distance uncertainty where measured ($e=1$, $2$).}}{figure.caption.25}{}}
